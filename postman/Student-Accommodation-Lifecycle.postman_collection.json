    {
      "name": "1 Happy path: pending -> verified -> active -> inactive",
      "item": [
        {
          "name": "1.1 Landlord submits listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{landlordId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/landlord/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "landlord",
                "listings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Room near campus\",\n  \"area\": \"st_augustine\",\n  \"price\": 1800,\n  \"amenities\": \"wifi,parking\",\n  \"contact_phone\": \"868-555-0101\",\n  \"contact_email\": \"landlord@example.com\",\n  \"photos\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "var l = pm.response.json().listing;",
                  "pm.collectionVariables.set('listingId', l.id);",
                  "pm.test('New listing starts as pending', function () { pm.expect(l.status).to.eql('pending'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Student browse: pending listing hidden",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{studentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "student",
                "listings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var ids = pm.response.json().listings.map(function (l) { return l.id; });",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Listing is NOT visible to the student', function () { pm.expect(ids.includes(Number(pm.collectionVariables.get('listingId')))).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Admin verifies",
