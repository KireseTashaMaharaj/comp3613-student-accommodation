                "api",
                "listings",
                "{{listingId}}",
                "transition"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"verify\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
